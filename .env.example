# Neon connection string for the "Commandos Game" project (pooled connection recommended).
# Get this from the Neon console: Commandos Game project -> Connection Details.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string — used to sign admin login sessions.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET="change-this-to-a-long-random-string"

# The first admin account, created automatically the first time you run the seed script.
SEED_ADMIN_NAME="Michael"
SEED_ADMIN_EMAIL="michaelmgrgs@gmail.com"
SEED_ADMIN_PASSWORD="change-this-password"
